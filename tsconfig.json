{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@vertex/ui": ["packages/ui/src"],
      "@vertex/auth": ["packages/auth/src"],
      "@vertex/database": ["packages/database/dist"],
      "@vertex/config": ["packages/config/src"],
      "@vertex/types": ["packages/types/src"],
      "@vertex/validation": ["packages/validation/src"],
      "@vertex/events": ["packages/events/src"],
      "@vertex/permissions": ["packages/permissions/src"],
      "@vertex/providers": ["packages/providers/src"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next"]
}