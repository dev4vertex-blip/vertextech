{
  "name": "vertextech",
  "version": "0.1.0",
  "private": true,
  "description": "VERTEX — Multi-tenant Business Operating Platform",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "echo \"Run specific app with: pnpm --filter <app-name> dev\"",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
